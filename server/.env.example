NODE_ENV=development
PORT=5000
MONGODB_URI=
# On Render: set CLIENT_URL to your Render address, for example https://civiconnect.onrender.com
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7
# Minutes without activity before the "Are you still there?" popup (the server allows a few minutes more).
SESSION_IDLE_MINUTES=15

# Used only by: npx tsx src/scripts/seedAdmin.ts
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# From the Cloudinary dashboard (needed only for photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Photo Assistant (ml/ folder). Leave empty to use http://localhost:8000
VISION_URL=

# Email for "Forgot password" (optional). Leave empty and the reset link is printed in the server terminal.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address, SMTP_PASS=a Gmail "App password"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
